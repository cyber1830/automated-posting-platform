# Copy to .env and fill in the platforms you want to use.
# Platforms with missing credentials are reported as "failed" (not skipped),
# and never stop the others from posting.

REQUEST_TIMEOUT_SECONDS=15
PLATFORM_TIMEOUT_SECONDS=30
VERIFY_PUBLIC_ACCESS=true

# --- DEV.to  (Settings > Extensions > Generate API key) ----------------
DEVTO_API_KEY=

# --- Telegraph (generate token via api.telegra.ph/createAccount) --------
TELEGRAPH_ACCESS_TOKEN=

# --- Bluesky (Settings > App Passwords)
BLUESKY_IDENTIFIER=yourname.bsky.social
BLUESKY_APP_PASSWORD=

# --- GitHub Gist (fine-grained/classic token with the "gist" scope) ----
GITHUB_TOKEN=

# --- Telegram (create a bot with @BotFather, add it as admin of a PUBLIC channel)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_USERNAME=
